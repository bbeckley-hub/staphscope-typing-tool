# Include all Python source files
include staphscope/*.py
recursive-include staphscope *.py

# Include ALL module files - especially AMR data
recursive-include staphscope/modules **

# Include configuration files
include *.md
include *.txt
include *.yml
include *.yaml
include LICENSE
include CITATION.cff
include setup.py
include requirements.txt

# Include scripts
include scripts/*
include cleanup.sh

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude *~
global-exclude .*
global-exclude *.bak
global-exclude *.log
global-exclude *.tmp
