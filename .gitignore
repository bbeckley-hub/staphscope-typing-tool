# Large data files - but ALLOW the specific ones we need
*.fna
*.faa

# BUT DO NOT IGNORE these specific fasta files that our tools need:
!staphscope/tools/spatyper/spa_typing/main/sparepeats.fasta
!staphscope/tools/sccmecfinder/database/*.fasta
!staphscope/tools/mlst/db/blast/mlst.fa

# Allow the BLAST database files but not other generated files
staphscope/tools/mlst/db/blast/*
!staphscope/tools/mlst/db/blast/mlst.fa.*
!staphscope/tools/mlst/db/blast/mlst.fa

# Allow SCCmecFinder template database files
!staphscope/tools/sccmecfinder/database/template_db/*.p

